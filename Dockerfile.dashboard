# ============================================================
# Dockerfile.dashboard — ANN From Scratch: MNIST Monitoring UI
# ============================================================
FROM python:3.12-slim

WORKDIR /app

COPY requirements_dashboard.txt .
RUN pip install --no-cache-dir -r requirements_dashboard.txt

COPY src/ src/
COPY monitoring/ monitoring/
COPY services/ services/
COPY ann_models/ ann_models/
COPY logs/ logs/

ENV MNIST_API_URL=http://localhost:8000
EXPOSE 8501

CMD ["streamlit", "run", "monitoring/monitoring_dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
